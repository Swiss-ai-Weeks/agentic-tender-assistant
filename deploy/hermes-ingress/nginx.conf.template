worker_processes 1;
events { worker_connections 256; }
http {
  auth_basic "Hermes workshop";
  auth_basic_user_file /etc/nginx/hermes.htpasswd;
  map_hash_bucket_size 128;
  server_names_hash_bucket_size 128;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  map $http_origin $origin_allowed {
    default 0;
    '' 1;
    'https://${HERMES_PUBLIC_HOST}' 1;
  }
  map $http_origin $upstream_origin {
    '' '';
    default 'http://127.0.0.1:18789';
  }
  map "$request_method:$http_sec_fetch_mode:$http_sec_fetch_dest:$http_sec_fetch_site" $blocked_cross_site {
    default 0;
    "GET:navigate:document:cross-site" 0;
    ~:cross-site$ 1;
  }
  server {
    listen 127.0.0.1:18890 default_server;
    server_name ${HERMES_PUBLIC_HOST};
    if ($host != '${HERMES_PUBLIC_HOST}') { return 421; }
    if ($origin_allowed = 0) { return 403; }
    if ($blocked_cross_site = 1) { return 403; }
    client_max_body_size 20m;
    location / {
      proxy_pass http://127.0.0.1:18789;
      proxy_http_version 1.1;
      proxy_set_header Host '127.0.0.1:18789';
      proxy_set_header Origin $upstream_origin;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 3600s;
      proxy_redirect http://127.0.0.1:18789/ https://${HERMES_PUBLIC_HOST}/;
      add_header X-Content-Type-Options nosniff always;
      add_header Referrer-Policy same-origin always;
    }
  }
}
