# Copy to .env and fill in values. Never commit the real .env file.

# LLM provider — keep swappable, don't hardcode a single vendor in code.
LLM_PROVIDER=          # e.g. openai | anthropic | nvidia-nim | azure-openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=          # for self-hosted / NIM endpoints

# NVIDIA NeMo Agent Toolkit (`nat` CLI) — see docs/architecture.md "Orchestration"
NVIDIA_API_KEY=
NAT_CONFIG_FILE=configs/tender_assistant.yml

# Live tender discovery (src/agents/tender_search.py) — calls Tavily directly.
# Same provider NemoClaw/Hermes uses natively for this sandbox's own web
# search (see docs/aiq-blueprint.md "Hermes's native Tavily web search") —
# get a key at tavily.com.
TAVILY_API_KEY=

# App
COMPANY_PROFILE_PATH=data/company_profile.example.json
