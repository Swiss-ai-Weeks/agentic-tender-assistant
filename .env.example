# Copy to .env and fill in values. Never commit the real .env file.

# LLM provider — keep swappable, don't hardcode a single vendor in code.
LLM_PROVIDER=          # e.g. openai | anthropic | nvidia-nim | azure-openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=          # for self-hosted / NIM endpoints

# NVIDIA NeMo Agent Toolkit (`nat` CLI) — see docs/architecture.md "Orchestration"
NVIDIA_API_KEY=
NAT_CONFIG_FILE=configs/tender_assistant.yml

# Live tender discovery (src/agents/tender_search.py) — calls Tavily directly.
# Same provider NemoClaw/Hermes uses natively for this sandbox's own web
# search (see docs/aiq-blueprint.md "Hermes's native Tavily web search") —
# get a key at tavily.com.
TAVILY_API_KEY=

# Optional model candidate proposer (src/opportunity/nemotron.py) — DISABLED by
# default. Nothing contacts a model unless TENDER_LLM_ENABLED=1 AND the call
# site passes use_llm=True. Candidates are validated strictly and decided by
# the deterministic compiler; the model never judges eligibility.
# Verified against: http://127.0.0.1:18000/v1 with h100-lab-nemotron-4b-fp8
# (isolated lab, GPU 1). Never point this at Hermes's port 8000 (GPU 0).
TENDER_LLM_ENABLED=
TENDER_LLM_BASE_URL=     # e.g. http://127.0.0.1:18000/v1
TENDER_LLM_MODEL=        # e.g. h100-lab-nemotron-4b-fp8
TENDER_LLM_API_KEY=      # optional bearer token; omit for local lab endpoints
TENDER_LLM_TIMEOUT_S=8
TENDER_LLM_MAX_CHARS=2000

# Isolated test/validation database (defaults to data/evidence_provenance.db).
# Tests must set this to a temporary path; never overwrite the real DB.
TENDER_DB_PATH=

# App
COMPANY_PROFILE_PATH=data/company_profile.example.json
