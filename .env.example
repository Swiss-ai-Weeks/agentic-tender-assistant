# Copy to .env and fill in values. Never commit the real .env file.

# LLM provider — keep swappable, don't hardcode a single vendor in code.
LLM_PROVIDER=          # e.g. openai | anthropic | nvidia-nim | azure-openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=          # for self-hosted / NIM endpoints

# NVIDIA NeMo Agent Toolkit (if/when adopted — see docs/architecture.md "Orchestration")
NVIDIA_API_KEY=
NEMO_AGENT_TOOLKIT_CONFIG=

# App
COMPANY_PROFILE_PATH=data/company_profile.example.json
